{
  "name": "flowpdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build:wasm": "cargo build -p flow-wasm --target wasm32-unknown-unknown --release --locked",
    "check": "node scripts/check-phase1.mjs",
    "test": "vitest run --passWithNoTests",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=./work/playwright vitest run --project browser --passWithNoTests",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "4.1.6",
    "fake-indexeddb": "6.2.4",
    "playwright": "1.57.0",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  }
}

